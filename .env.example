# ---------- Java backend ----------

# Port the load balancer control plane listens on
PORT=8080

# Comma separated browser origins allowed to reach the API (leave blank = allow any, for dev)
# Example: CORS_ORIGINS=http://localhost:3000,https://javalb.vercel.app
CORS_ORIGINS=

# Optional Supabase Postgres connection string for experiment history.
# If absent, experiments run without persistence. Accepts either a native
# postgresql:// URL or an already-converted jdbc:postgresql:// URL.
# SUPABASE_DB_URL=postgresql://postgres.<proj>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------- Frontend (Next.js on Vercel) ----------

# Public URL of the deployed Java load balancer (no trailing slash)
# NEXT_PUBLIC_LB_URL=https://your-lb.up.railway.app
NEXT_PUBLIC_LB_URL=http://localhost:8080

# Supabase project credentials for the dashboard's experiment history view
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...