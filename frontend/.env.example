# Public URL of the deployed Java load balancer (with protocol, no trailing slash)
# In dev the Next.js app and the LB both run on localhost.
NEXT_PUBLIC_LB_URL=http://localhost:8080

# Supabase project credentials (for the Experiment history view; optional — the
# dashboard works fine without them and falls back to the Java REST endpoint).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=